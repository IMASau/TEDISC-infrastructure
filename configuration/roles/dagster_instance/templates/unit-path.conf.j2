# Rendered from roles/dagster_instance/templates/unit-path.conf.j2.
# Do not hand-edit — changes will be overwritten on the next play run.
#
# podman resolves the `credHelpers` entry in ~/.docker/config.json to a
# docker-credential-github-app executable on the pulling process's PATH, and
# systemd user units get a default PATH without ~/.local/bin (extending it
# via ~/.config/environment.d is unreliable: an imported manager environment
# takes precedence over the generator output). A drop-in keeps the shipped
# unit file — which comes from the instance repo, not this one — pristine.
#
# %h is the unit user's home. The tail restates systemd's default user PATH,
# which Environment= replaces rather than extends.
[Service]
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
