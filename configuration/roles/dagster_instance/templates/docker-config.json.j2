{# Rendered from roles/dagster_instance/templates/docker-config.json.j2.
   Do not hand-edit — changes will be overwritten on the next play run.

   This is a podman host, so ~/.docker/ looks like the wrong home for this
   file. It isn't. Rootless podman's default authfile is
   ${XDG_RUNTIME_DIR}/containers/auth.json — i.e. under /run/user/<uid>,
   which is tmpfs and is wiped on reboot. Podman's documented fallback is
   ~/.docker/config.json, which is persistent and needs no REGISTRY_AUTH_FILE
   exported into the podman client's environment — which matters because the
   systemd units ship from the instance repo rather than this one.

   The `auth` value is the same base64("user:token") that `podman login`
   would write; rendering it here means no login step and nothing to redo
   after a reboot. #}
{
  "auths": {
    "{{ dagster_registry }}": {
      "auth": "{{ (dagster_gitea_user ~ ':' ~ dagster_gitea_token) | b64encode }}"
    }
  }
}
