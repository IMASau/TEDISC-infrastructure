# Rendered from roles/dagster_instance/templates/gitconfig.j2.
# Do not hand-edit — changes will be overwritten on the next play run.
#
# The `store` helper reads ~/.git-credentials (rendered alongside this file,
# mode 0600). Scoped to the Gitea host so remotes on any other host are
# untouched. Both the play-time clone and the deploy timer's later `git pull`
# fetch over HTTPS with it, and no token ever lands in .git/config.
[credential "https://{{ dagster_registry }}"]
	helper = store
