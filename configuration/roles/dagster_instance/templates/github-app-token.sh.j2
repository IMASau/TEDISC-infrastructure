#!/usr/bin/env bash
# Rendered from roles/dagster_instance/templates/github-app-token.sh.j2.
# Do not hand-edit — changes will be overwritten on the next play run.
#
# Mints a GitHub App installation access token and caches it for reuse.
# Installation tokens expire after an hour, so this runs at *pull* time, not
# provisioning time — it backs both the git credential helper (~/.gitconfig)
# and podman's docker-credential-github-app shim, and can be run bare for
# debugging:
#
#   github-app-token [token [<owner>]]       # print a token
#   github-app-token git-credential get      # git credential-helper protocol
#   github-app-token docker-credential get   # docker credential-helper protocol
#
# Installations are per GitHub *account*, so repos owned by different
# users/orgs need distinct installation ids — hence the owner -> id map. The
# owner is resolved from, in order: the explicit argument, $GITHUB_APP_OWNER
# (set per unit instance by a systemd drop-in, since podman tells credential
# helpers only the registry hostname), or — when exactly one installation is
# configured — that sole entry.
#
# The JWT-signing dance follows GitHub's documented example
# (docs.github.com → "Generating a JSON Web Token (JWT) for a GitHub App").
set -euo pipefail
# Without this, errexit doesn't apply inside $(...) — a failed curl in mint()
# would fall through to the JSON parse instead of aborting cleanly.
shopt -s inherit_errexit

APP_ID="{{ dagster_github_app_id }}"
KEY_PATH="{{ dagster_github_app_key_path }}"

declare -A INSTALLATIONS=(
{% for owner, id in dagster_github_app_installations.items() %}
  ["{{ owner }}"]="{{ id }}"
{% endfor %}
)
{% if dagster_github_app_installations | length == 1 %}
DEFAULT_OWNER="{{ dagster_github_app_installations | first }}"
{% else %}
DEFAULT_OWNER=""
{% endif %}

# Cache is per-user (helpers always run as the dagster user). Persistent
# location rather than XDG_RUNTIME_DIR, which isn't set in every context the
# helpers run from; staleness doesn't matter when entries live under an hour.
CACHE_DIR="${HOME}/.cache/github-app"

resolve_owner() {
  local owner="${1:-${GITHUB_APP_OWNER:-$DEFAULT_OWNER}}"
  if [[ -z "$owner" ]]; then
    echo "github-app-token: cannot determine repo/package owner (pass one, or set GITHUB_APP_OWNER)" >&2
    return 64
  fi
  if [[ -z "${INSTALLATIONS[$owner]:-}" ]]; then
    echo "github-app-token: no installation id configured for owner '${owner}'" >&2
    return 64
  fi
  printf '%s\n' "$owner"
}

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# Prints "<epoch-expiry> <token>" for the given owner's installation.
mint() {
  local owner="$1" now header payload sig response
  now=$(date +%s)
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  # iat backdated 60s: GitHub rejects JWTs it considers future-dated, and
  # that must not strand an unattended timer run over minor clock skew.
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' \
    $((now - 60)) $((now + 540)) "$APP_ID" | b64url)
  sig=$(printf '%s.%s' "$header" "$payload" \
    | openssl dgst -sha256 -sign "$KEY_PATH" | b64url)

  response=$(curl --silent --show-error --fail --request POST \
    --header "Authorization: Bearer ${header}.${payload}.${sig}" \
    --header "Accept: application/vnd.github+json" \
    --header "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app/installations/${INSTALLATIONS[$owner]}/access_tokens")

  # python3 rather than jq: guaranteed present on an ansible-managed host.
  python3 -c '
import datetime, json, sys
r = json.load(sys.stdin)
exp = datetime.datetime.fromisoformat(r["expires_at"].replace("Z", "+00:00"))
print(int(exp.timestamp()), r["token"])
' <<<"$response"
}

get_token() {
  local owner="$1" cache_file="${CACHE_DIR}/token-$1" now expiry token line tmp
  now=$(date +%s)
  if [[ -r "$cache_file" ]]; then
    read -r expiry token < "$cache_file" || true
    # 5-minute margin so a cached token can't expire mid-deploy.
    if [[ "${expiry:-}" =~ ^[0-9]+$ && -n "${token:-}" && "$expiry" -gt $((now + 300)) ]]; then
      printf '%s\n' "$token"
      return 0
    fi
  fi
  mkdir -p "$CACHE_DIR"
  chmod 700 "$CACHE_DIR"
  line=$(mint "$owner")
  # Write-then-rename: concurrent invocations (two instance timers firing
  # together) see the old entry or the new one, never a torn file. mktemp
  # creates mode 0600.
  tmp=$(mktemp "${CACHE_DIR}/.token.XXXXXX")
  printf '%s\n' "$line" > "$tmp"
  mv "$tmp" "$cache_file"
  printf '%s\n' "${line#* }"
}

case "${1:-token}" in
  token)
    owner=$(resolve_owner "${2:-}")
    get_token "$owner"
    ;;
  git-credential)
    # Protocol: action in $2, key=value attributes on stdin (must be
    # drained). `useHttpPath = true` in ~/.gitconfig makes git send
    # path=<owner>/<repo>.git, from which the owner falls out. Only `get`
    # answers; store/erase are meaningless for minted tokens but must
    # succeed silently or git aborts the operation.
    repo_path=""
    while IFS='=' read -r key value; do
      [[ "$key" == "path" ]] && repo_path="$value"
    done
    if [[ "${2:-}" == "get" ]]; then
      owner=$(resolve_owner "${repo_path%%/*}")
      printf 'username=x-access-token\npassword=%s\n' "$(get_token "$owner")"
    fi
    ;;
  docker-credential)
    # Protocol: action in $2, server name on stdin — the hostname only, so
    # the owner must come from $GITHUB_APP_OWNER (or the sole-entry
    # default). GHCR ignores the username when the secret is a token, but
    # it must be non-empty.
    if [[ "${2:-}" == "get" ]]; then
      server=$(cat)
      owner=$(resolve_owner)
      printf '{"ServerURL":"%s","Username":"x-access-token","Secret":"%s"}\n' \
        "$server" "$(get_token "$owner")"
    else
      cat > /dev/null
    fi
    ;;
  *)
    echo "usage: github-app-token [token [<owner>]]|git-credential <action>|docker-credential <action>" >&2
    exit 64
    ;;
esac
